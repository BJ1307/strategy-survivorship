        "acf_absret_lag63": 0.04561853401757275
      },
      "scale_provenance": "across-path standard deviation of each target under the STAGE 2 same-length reference simulation (sv_jump, matched scale, 2000 paths x 1258 days), fixed before this search. It is deliberately NOT recomputed per candidate: that would reward a candidate whose simulated spread happened to be wide",
      "scale_floor": 0.0001,
      "scales_that_hit_the_floor": [],
      "comparison_point": "the simulated MEDIAN across paths against the single sample value, at the same sample length",
