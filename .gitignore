# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Scratch runs. The full-scale outputs/ tree IS tracked: it is the Stage 1
# deliverable and it is regenerated byte-for-byte by
#   python -m strategy_survivorship.run_stage1
outputs/smoke*/
outputs/tmp*/
outputs/status.json

# Review bundles are BUILD PRODUCTS: each one repackages the whole source tree
# plus a slice of outputs/.  Rebuild with `make bundle STAGE=3b`, or read the
# `pre-consolidation` tag for the ones handed over during the week.
outputs/review_bundle*/
outputs/*.zip

# Real market data. FRED states the S&P 500 series comes from S&P Dow Jones
# Indices and may not be redistributed, so the raw snapshots and every per-day
# derived series stay local. The downloader, the protocol and the data dictionary
# ARE tracked. The data is not, and NEITHER ARE THE PROVENANCE SIDECARS: they live
# under data/ and this rule seals the whole directory, so `data/raw/*.provenance.json`
# and `acquisition.provenance.json` stay local too and are supplied out of band.
# (Earlier wording here claimed the provenance record was tracked. It never was.)
data/
outputs/market/

# OS / editor
.DS_Store
.idea/
.vscode/
